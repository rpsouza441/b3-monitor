# Copy to .env and fill in locally. NEVER commit a real .env.
# Database (local docker-compose Postgres)
B3MONITOR_DB_PASSWORD=change-me-locally
B3MONITOR_DB_URL=jdbc:postgresql://127.0.0.1:5432/b3monitor
B3MONITOR_DB_USER=b3monitor

# Brapi API token (Free tier). Leave empty to run without authenticated calls.
B3MONITOR_BRAPI_TOKEN=
